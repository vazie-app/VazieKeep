# Vazie Keep: what git must never see. Written as if the repository were public.
#
# Only rules that belong to the project live here: secrets, build output, generated code. What belongs to one person
# or one machine (editors, AI tools, OS files, local art and notes) goes to .git/info/exclude instead.
# Git applies the last matching rule, so the exceptions at the very end win over everything above them.

# ── Secrets, keys and signing material ───────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local
local.properties
secrets.properties
keystore.properties
signing.properties
key.properties
signKeystore/
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.p8
*.der
*.cer
*.mobileprovision
*.provisionprofile
Secrets.xcconfig
google-services.json
GoogleService-Info.plist
agconnect-services.json
credentials*.json
service-account*.json
.netrc

# ── Real password databases and key files (synthetic ones are re-allowed at the end) ────────
*.kdbx
*.kdb
*.keyx

# ── Build output and caches ───────────────────────────────────────────────────────────────────
# Android / Gradle
.gradle/
.kotlin/
build/
out/
captures/
.externalNativeBuild/
.cxx/
*.hprof
*.apk
*.aab
*.aar
*.ap_
*.dex
*.jar
# Apple
DerivedData/
xcuserdata/
*.xcresult
*.xcframework/
*.ipa
*.dSYM/
*.dSYM.zip
.build/
.swiftpm/
Pods/
# Native libraries
*.so
*.a
*.dylib
# Rust
target/
# JavaScript
node_modules/
.next/
dist/
coverage/
*.tsbuildinfo
# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# Logs and archives
*.log
*.zip

# ── Generated by the build, never edited ─────────────────────────────────────────────────────
/core/keep-core-wasm/pkg/
/core/fuzz/corpus/
/core/fuzz/artifacts/
/core/fuzz/coverage/
/apps/**/bin/
/tooling/**/bin/
apps/apple/*.xcodeproj/
apps/apple/KeepAppleKit/Generated/
apps/apple/KeepAppleKit/Sources/KeepCoreBindings/

# ── Exceptions: synthetic test material, which exists only to test the core ────────────────────
# Keep this block last: it has to win over the rules above.
!shared/test-vectors/**
!shared/fixtures/**
!core/keep-core/tests/data/**
