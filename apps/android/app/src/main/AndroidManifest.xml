<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network use: signing in to a Vazie Account and checking Keep+; website icons, when the person asks
         for them; and asking a site which apps may use its passkeys. Opening, editing and creating vaults
         never needs a connection. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Only to scan a one-time-code QR; nothing is recorded or sent, and a phone without a camera still works. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Only the browsers whose page host Autofill believes (TrustedBrowsers.Default) are queried, so their
         signing certificates can be read. Other apps are verified through the calling package of the
         authentication screen instead (ADR 0016, M11.1). Keep this list in step with TrustedBrowsers. -->
    <queries>
        <package android:name="com.android.chrome" />
    </queries>

    <application
        android:name=".KeepApplication"
        android:allowBackup="false"
        tools:targetApi="33"
        tools:ignore="CredentialDependency"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher_classic"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VazieKeep">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:theme="@style/Theme.VazieKeep.Sheet"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".autofill.AutofillSaveActivity"
            android:theme="@style/Theme.VazieKeep.Sheet"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".passkeys.PasskeyActivity"
            android:theme="@style/Theme.VazieKeep.Sheet"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- Vazie Keep offers passkeys through this service; it never asks other providers for credentials, so
             the Play services bridge that lint suggests for callers is not needed. -->
        <service
            android:name=".passkeys.KeepCredentialProviderService"
            android:enabled="@bool/passkeys_supported"
            tools:targetApi="34"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <service
            android:name=".autofill.VazieAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <activity-alias
            android:name=".launcher.KeepClassic"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
