{
  "name": "@vazie/keep-browser-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "PolyForm-Shield-1.0.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "core:wasm": "bash ../../scripts/build-core.sh wasm",
    "dev": "node scripts/build.mjs --development",
    "build": "pnpm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "test": "node --test tests/*.test.ts",
    "icons": "bash scripts/make-icons.sh",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
